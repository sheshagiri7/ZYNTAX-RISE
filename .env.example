# API Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False

# Kafka Configuration (Apache Kafka 3.7.0)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=csv-rows
KAFKA_GROUP_ID=zyntax-loader-group
KAFKA_RETRY_COUNT=5
KAFKA_RETRY_DELAY=2.0

# Neo4j Graph Database (Neo4j 5.x)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=csvgraphdb
NEO4J_DATABASE=CSV_Graph_DB
NEO4J_RETRY_COUNT=5
NEO4J_RETRY_DELAY=2.0

# LLM API Keys (Member 3 - AI/Chatbot Server-side only)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
